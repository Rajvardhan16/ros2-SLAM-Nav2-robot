<?xml version="1.0"?>
<sdf version="1.9">
  <world name="multi_room_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ OUTER BOUNDARY WALLS ============ -->
    <model name="outer_wall_1">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="outer_wall_2">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="outer_wall_3">
      <static>true</static>
      <pose>6 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="outer_wall_4">
      <static>true</static>
      <pose>-6 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ INTERIOR WALL — splits building into left/right halves, with doorway gap ============ -->
    <model name="divider_wall_vertical_top">
      <static>true</static>
      <pose>0 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 5 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.9 1</ambient><diffuse>0.7 0.7 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="divider_wall_vertical_bottom">
      <static>true</static>
      <pose>0 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 5 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.9 1</ambient><diffuse>0.7 0.7 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <!-- gap between y=1 and y=-1 acts as doorway between left/right halves -->

    <!-- ============ HORIZONTAL WALL — splits right half into two rooms (top-right / bottom-right) ============ -->
    <model name="divider_wall_horizontal_right">
      <static>true</static>
      <pose>3.5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5 0.2 1</size></box></geometry>
          <material><ambient>0.7 0.9 0.7 1</ambient><diffuse>0.7 0.9 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ HORIZONTAL WALL — splits left half into two rooms (top-left / bottom-left) ============ -->
    <model name="divider_wall_horizontal_left">
      <static>true</static>
      <pose>-3.5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5 0.2 1</size></box></geometry>
          <material><ambient>0.9 0.7 0.7 1</ambient><diffuse>0.9 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ OBJECTS: boxes, cylinders scattered in each room ============ -->

    <model name="box_1">
      <static>true</static>
      <pose>-4.5 4.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_1">
      <static>true</static>
      <pose>-1.5 4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.6 0.9 1</ambient><diffuse>0.3 0.6 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>4.5 4.5 0.3 0 0 0.6</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.9 0.7 0.2 1</ambient><diffuse>0.9 0.7 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_2">
      <static>true</static>
      <pose>1.8 4.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.5 0.9 0.5 1</ambient><diffuse>0.5 0.9 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_3">
      <static>true</static>
      <pose>-4.5 -4.5 0.35 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.4 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.4 0.7</size></box></geometry>
          <material><ambient>0.6 0.3 0.8 1</ambient><diffuse>0.6 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_3">
      <static>true</static>
      <pose>-1.8 -4.8 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.9 0.5 0.7 1</ambient><diffuse>0.9 0.5 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_4">
      <static>true</static>
      <pose>4.2 -4.2 0.4 0 0 1.1</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.3 0.8 0.8 1</ambient><diffuse>0.3 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_5">
      <static>true</static>
      <pose>1.5 -4.8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
